# --- Claude lookup (optional but recommended) ---------------------------------
# Powers the "Ask Claude" button: looks a food up on the web and returns
# structured nutrition facts for anything not already in the catalog.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- USDA FoodData Central (optional) -----------------------------------------
# Free, generous limits. Without a key the app falls back to DEMO_KEY, which is
# rate limited to ~30 requests/hour and will start failing quickly.
# Get a free key in about 30 seconds at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Open Food Facts needs no key — it is used automatically for branded products
# and barcodes.
